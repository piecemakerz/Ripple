{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run format:check && npm run typecheck && npm run ai:doctor && npm run relate:context && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "tsx scripts/doctor.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:owner": "tsx scripts/evaluate.ts --case async-owner",
    "evaluate:semver": "tsx scripts/evaluate.ts --case semver-deprecation",
    "evaluate:demo": "npm run build && tsx scripts/evaluate.ts --demo",
    "evaluate:semver:demo": "npm run build && tsx scripts/evaluate.ts --demo --case semver-deprecation",
    "relate:context": "tsx scripts/relate-context.ts",
    "reproduce": "tsx scripts/reproduce.ts",
    "ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-astra.ps1",
    "ai:doctor": "tsx scripts/ai-doctor.ts",
    "ci:status": "tsx scripts/ci-status.ts",
    "ai:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-astra.ps1 -Check"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@relate/relate": "1.0.1",
    "express": "5.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/piecemakerz/Ripple.git"
  }
}
